<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Pogodynka{% endblock %}</title>

    {# Bootstrap 5 CSS #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=53934") repeat;
            background-attachment: fixed;
            background-size: auto;
        }

        main {
            background-color: rgba(255, 255, 255, 0.85);
            border-radius: 1rem;
            padding: 2rem;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">🌤️ Pogodynka</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_location' %}active{% endif %}"
                       href="{{ path('app_location_index') }}">
                        Lokalizacje
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if app.request.get('_route') starts with 'app_measurement' %}active{% endif %}"
                       href="{{ path('app_measurement_index') }}">
                        Pomiary
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container my-4 py-4">
    {% block body %}{% endblock %}
</main>

<footer class="text-center py-3 mt-5 border-top text-muted small">
    &copy; {{ "now"|date("Y") }} Pogodynka — projekt Symfony
</footer>

{# Bootstrap JS (for hamburger toggle) #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
